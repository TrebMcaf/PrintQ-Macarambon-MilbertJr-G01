DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (required for the final setup) ---
# Supabase dashboard → Connect → "Session pooler" connection string (works on IPv4 networks).
# Replace [YOUR-PASSWORD] with your database password. Keep this file private.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# (Transaction pooler on port 6543 also works; PrintQ auto-adjusts for it.)

# --- File storage (optional; local private_uploads/ is used if blank) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service-role-key>
SUPABASE_BUCKET=print-files

SEED_OPERATOR_EMAIL=operator@printq.test
SEED_OPERATOR_PASSWORD=<choose-a-password>
SEED_ADMIN_EMAIL=admin@printq.test
SEED_ADMIN_PASSWORD=<choose-a-password>
